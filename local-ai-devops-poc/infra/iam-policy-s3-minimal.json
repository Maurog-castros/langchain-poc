{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProjectPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "local-ai-devops-poc/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteProjectArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/local-ai-devops-poc/*"
    }
  ]
}
